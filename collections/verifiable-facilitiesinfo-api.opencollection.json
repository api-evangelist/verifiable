      "items": [
        {
          "info": {
            "name": "Get info for the existing facility\n",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://discovery.verifiable.com/api/facilities/:facilityId/info",
            "params": [
              {
                "name": "facilityId",
                "value": "",
                "type": "path",
                "description": "Identifier of the facility to get the data for."
              },
              {
                "name": "facilityInfoTypes",
                "value": "",
                "type": "query",
                "description": "If not specified, will return all data for the facility. Info types can be combined, ex.: `facilityInfoTypes=npi&facilityInfoTypes=dea`."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the info for a specific facility.\n"
        },
